# Credenciais e configuração local
.env
*.env

# Resultados: ignora conteúdo mas permite git entrar no dir (resultados/* em vez de resultados/)
resultados/*
!resultados/.gitkeep
!resultados/piloto/
!resultados/piloto/**
!resultados/tests/
!resultados/tests/**
!resultados/d19/
!resultados/d19/**
!resultados/c2_inducao/
!resultados/c2_inducao/**
!resultados/Logs/
!resultados/Logs/**
!resultados/piloto_v3/
!resultados/piloto_v3/**
!resultados/avaliacao_piloto_v3/
!resultados/avaliacao_piloto_v3/**
# Avaliação das rodadas full (saída por frase lida pelo app) — scripts/avaliar_full.py
!resultados/avaliacao_full/
!resultados/avaliacao_full/**
# Experimento completo (C-1): saída por modelo em resultados/7b/ e resultados/full/<slug>/
!resultados/7b/
!resultados/7b/**
!resultados/full/
!resultados/full/**

# Python
__pycache__/
*.py[cod]
