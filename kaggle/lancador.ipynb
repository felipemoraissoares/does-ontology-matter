<cell id="cell-6"># Célula 6 — Subir vLLM em segundo plano
# dtype=half obrigatório para T4 (fp16). tensor-parallel-size=2 usa ambas as GPUs T4.

vllm_cmd = (
    f"vllm serve {MODELO} "
    f"--port {PORT} "
    f"--dtype half "
    f"--tensor-parallel-size 2 "
    f"--max-model-len 4096 "
    f"--gpu-memory-utilization 0.90 "
    f"> {VLLM_LOG} 2>&1 &"
)
os.system(vllm_cmd)
print(f"vLLM iniciado em segundo plano. Log: {VLLM_LOG}")</cell id="cell-6">
<cell id="cell-7"># Célula 7 — Aguardar vLLM pronto (polling automático /health)
import time, urllib.request, urllib.error

VLLM_URL  = f"http://localhost:{PORT}"
TIMEOUT   = 360  # segundos
INTERVALO = 10
elapsed   = 0

while elapsed < TIMEOUT:
    try:
        urllib.request.urlopen(f"{VLLM_URL}/health", timeout=3)
        print(f"vLLM pronto após {elapsed}s.")
        break
    except (urllib.error.URLError, ConnectionRefusedError, OSError):
        if elapsed % 30 == 0:
            print(f"  aguardando vLLM... ({elapsed}s / {TIMEOUT}s)")
        time.sleep(INTERVALO)
        elapsed += INTERVALO
else:
    print(f"ERRO: vLLM não respondeu em {TIMEOUT}s. Últimas linhas do log:")
    run(f"tail -40 {VLLM_LOG}", check=False)
    raise RuntimeError("vLLM não iniciou. Verifique GPU e modelo.")</cell id="cell-7">
<cell id="cell-8"># Célula 8 — Carregar manifesto D-19 com caminhos do Kaggle
import json

MINILANCADOR_SRC = f"{REPO_DIR}/configs/pipeline/minilancador_d19.json"
os.makedirs(D19_DIR, exist_ok=True)

with open(MINILANCADOR_SRC, encoding="utf-8") as f:
    d19_exps = json.load(f)

# Ajusta caminhos: substitui caminho relativo por caminho absoluto em D19_DIR
for exp in d19_exps:
    if "saida" in exp:
        nome = os.path.basename(exp["saida"])
        exp["saida"] = f"{D19_DIR}/{nome}"

d19_path = f"{WORK_DIR}/minilancador_d19_kaggle.json"
with open(d19_path, "w", encoding="utf-8") as f:
    json.dump(d19_exps, f, ensure_ascii=False, indent=2)

print(f"Manifesto D-19 com {len(d19_exps)} experimentos -> {d19_path}")
for exp in d19_exps:
    existe = "[ja existe]" if os.path.exists(exp["saida"]) else "[pendente]"
    print(f"  {exp['id']}  {existe}")</cell id="cell-8">
<cell id="cell-9"># Célula 9 — Executar mini-teste D-19
# FORCE_RERUN=True: remove APENAS os d19_*.jsonl (preserva piloto-v2 existente).
# Mude para False para retomar uma sessão interrompida desta execução.

import glob

FORCE_RERUN = True
if FORCE_RERUN:
    removidos = glob.glob(f"{D19_DIR}/d19_*.jsonl")
    for f_rm in removidos:
        os.remove(f_rm)
    if removidos:
        print(f"FORCE_RERUN=True: {len(removidos)} JSONL d19_* removidos para re-execução.")
    else:
        print("FORCE_RERUN=True: nenhum JSONL d19_* encontrado (primeira execução).")

PYPATH = {**os.environ, "PYTHONPATH": f"{REPO_DIR}/src"}

run(
    f"python -m t2kg.run "
    f"--manifesto {d19_path} "
    f"--bench_dir {BENCH_DIR} "
    f"--skip_existentes "
    f"--verbose",
    cwd=REPO_DIR,
    env=PYPATH,
)
print("\nMini-teste D-19 concluído.")</cell id="cell-9">
<cell id="cell-10"># Célula 10 — Re-indução C2 com D-21 (threshold=0.70, freq_min=5, raw JSONL)
# Salva respostas cruas em resultados/c2_inducao/ para análise posterior.

import json as _json

os.makedirs(C2_RAW_DIR, exist_ok=True)
PYPATH = {**os.environ, "PYTHONPATH": f"{REPO_DIR}/src"}

manifesto_c2 = _json.load(open(f"{REPO_DIR}/configs/pipeline/reinducao_c2_kaggle.json"))
print(f"Re-indução C2 D-21: {len(manifesto_c2)} tarefa(s), threshold=0.70, freq_min=5")

for tarefa in manifesto_c2:
    onto    = tarefa["onto"]
    dataset = tarefa["dataset"]
    seed    = tarefa["seed"]

    # Remove arquivos inválidos anteriores (D-17) se existirem
    invalidos = [
        f"{C2_DIR}/{dataset}_{onto}_induced.json",
        f"{C2_DIR}/{dataset}_{onto}_frases_seed{seed}.json",
        f"{C2_DIR}/calibracao_{dataset}_{onto}.json",
    ]
    for p in invalidos:
        if os.path.exists(p):
            os.remove(p)
            print(f"  Removido (inválido D-17): {os.path.basename(p)}")

    raw_jsonl = f"{C2_RAW_DIR}/{os.path.basename(tarefa['saida_raw_jsonl'])}"
    print(f"\n--- Induzindo C2 para {dataset}/{onto} (threshold={tarefa['threshold']}, freq_min={tarefa.get('freq_min', 5)}) ---")
    run(
        f"python {REPO_DIR}/scripts/induzir_c2.py "
        f"--dataset {tarefa['dataset']} "
        f"--onto {tarefa['onto']} "
        f"--url {tarefa['url']} "
        f"--modelo_llm {tarefa['modelo']} "
        f"--threshold {tarefa['threshold']} "
        f"--n_frases {tarefa['n_frases']} "
        f"--seed {tarefa['seed']} "
        f"--freq_min {tarefa.get('freq_min', 5)} "
        f"{'--calibrar' if tarefa['calibrar'] else ''} "
        f"--saida_raw_jsonl {raw_jsonl} "
        f"--saida_dir {C2_DIR}",
        cwd=REPO_DIR,
        env=PYPATH,
    )

print("\nRe-indução C2 D-21 concluída.")
git("add -A")
git('commit -m "auto: C2 re-inducao D-21 (threshold=0.70, freq_min=5, raw JSONL)"')
git("push")
print("Push C2 OK.")</cell id="cell-10">
